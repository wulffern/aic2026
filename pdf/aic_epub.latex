\newcommand{\myfigwidth}{100mm}
\newcommand{\myfigheight}{100mm}

% Figures are capped, never inflated. \includegraphics[width=..] scales
% a graphic TO that width, so a drawing whose natural size is 40 mm was
% being blown up to fill the box. \aicfig measures the graphic first and
% asks for the smaller of its natural width and the cap; keepaspectratio
% with the height cap then bounds tall figures the same way.
\newsavebox{\aicfigbox}
\newlength{\aicfigw}
\newcommand{\aicfig}[1]{%
  \sbox{\aicfigbox}{\includegraphics{#1}}%
  \setlength{\aicfigw}{\wd\aicfigbox}%
  \ifdim\aicfigw>\myfigwidth\setlength{\aicfigw}{\myfigwidth}\fi
  \includegraphics[width=\aicfigw,height=\myfigheight,keepaspectratio]{#1}%
}



  \newcommand\BackgroundPic{%
\put(0,0){%
\parbox[b][\paperheight]{\paperwidth}{%
\vfill
\centering
\includegraphics[width=\paperwidth,height=\paperheight,%
keepaspectratio]{background.png}%
\vfill
}}}


% AI-content highlighting: chapters_epub written by Claude are wrapped in
% \begin{aicontent}...\end{aicontent} by py/lecture.py. In the normal
% build the environment does nothing; build with \def\AIHIGHLIGHT{}
% (make book-ai) and those chapters_epub are set in ink blue.
%
% An environment rather than a brace group on purpose: pandoc's LaTeX
% reader, which builds the epub, does not track a bare {\macro ... }
% across an \input and reports the closing brace as unexpected. It
% passes an unknown environment through without complaint.
% The book colour theme - the same luminance ladder the figures use,
% so the Conventions swatches and any coloured text match the art.
\definecolor{red}{RGB}{160,25,35}
\definecolor{blue}{RGB}{85,155,235}
\definecolor{armygreen}{RGB}{70,130,60}
\definecolor{orange}{RGB}{240,150,40}
\definecolor{oxteal}{RGB}{140,195,195}

\definecolor{aiink}{RGB}{15,60,150}
\newcommand{\aicontent}{}
\ifdefined\AIHIGHLIGHT\renewcommand{\aicontent}{\color{aiink}}\fi
\newenvironment{aicontent}{\begingroup\aicontent}{\endgroup}

