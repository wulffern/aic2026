# Figure review renders (make preview / make tikz-preview)
preview/
.build/

# TikZ figure output, built from tikz/*.tex by make tikz (CI: tikz-cached).
# Hand-drawn media/*.svg and their exported .pdf are sources and stay tracked;
# only the _tikz suffix marks a generated file.
media/*_tikz.pdf
media/*_tikz.svg
media/*/*_tikz.pdf
media/*/*_tikz.svg

# AUCTeX parse cache next to the pdf/ sources
pdf/.auctex*

# Book-site prototype: generated chapters and shared assets
docs-book/chapters/
docs-book/assets/
docs-book/_site/
docs-book/.jekyll-cache/
docs-book/vendor/
docs-book/.bundle/
docs-book/index.md
docs-book/pages/
docs-book/404.html

# Scripts in ex/ save their matplotlib output next to themselves. The
# figures that reach the book come from tikz/ via py/tikzplot.py, so the
# stray plots are just working files.
ex/*.pdf
ex/*.svg
ex/*.png

# Local, uncommitted working note (third-party figure review)
*.local.md

# Photos and clips shown in the guest-lecture decks (lectures/g*.md reference
# ../video/). Hundreds of megabytes of camera footage that would bloat the
# history, so the decks are committed and the media is not.
video/
