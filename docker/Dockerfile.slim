# Slim CI image: TeX Live 2022 scheme-small plus exactly the packages the
# book (kaobook), the standalone chapters and the TikZ figures load, instead
# of the ~5 GB texlive/texlive:TL2022-historic. Built to the 2026_slim tag by
# docker.yaml; matrix_build/tikz switch to it only after a full Docs run has
# passed on it (see build_plan.md item B).

FROM debian:bookworm-slim

RUN apt-get update && \
    apt-get -y install --no-install-recommends \
    ghostscript python3-pip poppler-utils wget imagemagick python3-svglib \
    python3-venv build-essential pkg-config libcairo2-dev python3-dev librsvg2-bin \
    git ca-certificates perl curl fontconfig unzip && \
    apt-get autoremove -y && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Pinned pandoc, same version and reason as the full image (see Dockerfile).
RUN wget -q https://github.com/jgm/pandoc/releases/download/3.6.4/pandoc-3.6.4-1-amd64.deb -O /tmp/pandoc.deb && \
    dpkg -i /tmp/pandoc.deb && rm /tmp/pandoc.deb && \
    pandoc --version | head -n 1

# TeX Live 2022 from the historic archive, scheme-small (pdflatex + latex
# recommended + fonts recommended), no docs or sources.
# texlive.info, not ftp.math.utah.edu: Utah serves its TLS chain without
# the intermediate ("unable to get local issuer certificate" inside the
# build), and ftp.tug.org's certificate does not cover that hostname.
ARG TL_HIST=https://texlive.info/historic/systems/texlive/2022
RUN mkdir /tmp/install-tl && cd /tmp/install-tl && \
    (curl -fSL -o install-tl-unx.tar.gz ${TL_HIST}/install-tl-unx.tar.gz || \
     curl -fSL -o install-tl-unx.tar.gz https://pi.kwarc.info/historic/systems/texlive/2022/install-tl-unx.tar.gz) && \
    tar xzf install-tl-unx.tar.gz --strip-components=1 && \
    printf '%s\n' \
      'selected_scheme scheme-small' \
      'tlpdbopt_install_docfiles 0' \
      'tlpdbopt_install_srcfiles 0' \
      'tlpdbopt_autobackup 0' \
      > texlive.profile && \
    ./install-tl --profile=texlive.profile \
      --repository=${TL_HIST}/tlnet-final && \
    rm -rf /tmp/install-tl

ENV PATH="/usr/local/texlive/2022/bin/x86_64-linux:${PATH}"

# What kaobook, short_tmplt, pandoc output and the TikZ figures need beyond
# scheme-small. Derived from \RequirePackage/\usepackage audits plus the
# build logs; tlmgr resolves dependencies.
RUN tlmgr --repository=${TL_HIST}/tlnet-final install \
    koma-script sidenotes marginnote marginfix changepage placeins chngcntr \
    footmisc footnotebackref footnotehyper fvextra imakeidx glossaries \
    nomencl xindy makeindex etoc multirow wrapfig ccicons hyphenat needspace \
    xifthen ifmtarg xstring xpatch options newpx fontaxes xkeyval tex-gyre \
    tex-gyre-math bera mathalpha courier helvetic symbol zapfding newtx txfonts boondox rsfso cleveref tcolorbox environ \
    tikzfill pdfcol listings minted upquote lineno algorithm2e ifoddpage \
    relsize morewrites bigfoot snotez zref dblfloatfix floatrow \
    fontawesome5 subfiles todonotes tikzpagenodes \
    pgf circuitikz standalone svg trimspaces transparent catchfile epstopdf kastrup \
    booktabs tabularray caption biblatex biber logreq \
    unicode-math fontspec lualatex-math csquotes ragged2e enumitem \
    listingsutf8 abstract thmtools was pdfpages pgfplots preview cite oberdiek \
    setspace parskip microtype xurl bookmark && \
    tlmgr path add

# Same python environment as the full image.
COPY requirements-ci.txt /tmp/requirements-ci.txt
RUN  python3 -m venv /pyenv && /pyenv/bin/python3 -m pip install -r /tmp/requirements-ci.txt
